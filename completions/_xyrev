#compdef xyrev

autoload -U is-at-least

_xyrev() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'*-v[Use verbose output (-vv very verbose/build.rs output)]' \
'*--verbose[Use verbose output (-vv very verbose/build.rs output)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_xyrev_commands" \
"*::: :->xyrev" \
&& ret=0
    case $state in
    (xyrev)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:xyrev-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'-f[Force reinitialize configuration (overwrite existing)]' \
'--force[Force reinitialize configuration (overwrite existing)]' \
'-C[Clean and reinitialize (remove all existing data)]' \
'--clean[Clean and reinitialize (remove all existing data)]' \
'*-v[Use verbose output (-vv very verbose/build.rs output)]' \
'*--verbose[Use verbose output (-vv very verbose/build.rs output)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(dotfile)
_arguments "${_arguments_options[@]}" : \
'*-v[Use verbose output (-vv for very verbose)]' \
'*--verbose[Use verbose output (-vv for very verbose)]' \
'-h[Print help]' \
'--help[Print help]' \
':name -- Dotfile name:_default' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_xyrev_commands] )) ||
_xyrev_commands() {
    local commands; commands=(
'init:Create a new configuration folder or reinitialize the existing one' \
'dotfile:' \
    )
    _describe -t commands 'xyrev commands' commands "$@"
}
(( $+functions[_xyrev__dotfile_commands] )) ||
_xyrev__dotfile_commands() {
    local commands; commands=()
    _describe -t commands 'xyrev dotfile commands' commands "$@"
}
(( $+functions[_xyrev__init_commands] )) ||
_xyrev__init_commands() {
    local commands; commands=()
    _describe -t commands 'xyrev init commands' commands "$@"
}

if [ "$funcstack[1]" = "_xyrev" ]; then
    _xyrev "$@"
else
    compdef _xyrev xyrev
fi
