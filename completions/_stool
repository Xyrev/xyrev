(( $+functions[_stool_commands] )) ||
_stool_commands() {
    local commands; commands=(
'init:Create a new configuration folder or reinitialize the existing one' \
'agent:' \
'apple:' \
'dotfile:Manage dotfiles from a Git repository' \
'completions:Generate shell completions from the current command definitions' \
'man:Render the manual, or write all command manuals to a directory' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'stool commands' commands "$@"
}
