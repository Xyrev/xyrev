.el .ds Aq '
.TH stool-agent-copilot 1  "stool-agent-copilot "
.SH NAME
stool\-agent\-copilot
.SH SYNOPSIS
\fBstool\-agent\-copilot\fR [\fB\-m\fR|\fB\-\-method\fR] [\fB\-\-prerelease\fR] [\fB\-\-version\fR] [\fB\-\-prefix\fR] [\fB\-h\fR|\fB\-\-help\fR]
.SH DESCRIPTION
.SH OPTIONS
.TP
\fB\-m\fR, \fB\-\-method\fR \fI<METHOD>\fR [default: auto]
Install method (auto, brew, npm, winget, script)
.TP
\fB\-\-prerelease\fR
Install prerelease version
.TP
\fB\-\-version\fR \fI<VERSION>\fR
Specific version to install (e.g., v0.0.369)
.TP
\fB\-\-prefix\fR \fI<PREFIX>\fR
Custom installation prefix (for script method)
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
