.TH xyrev-dotfile-gpg 1  "xyrev-dotfile-gpg "
.SH NAME
xyrev\-dotfile\-gpg \- Back up or restore GPG keys using encrypted dotfile storage
.SH SYNOPSIS
\fBxyrev\-dotfile\-gpg\fR [\fB\-h\fR|\fB\-\-help\fR] <\fIsubcommands\fR>
.SH DESCRIPTION
Back up or restore GPG keys using encrypted dotfile storage
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.SH SUBCOMMANDS
.TP
xyrev\-dotfile\-gpg\-backup(1)
